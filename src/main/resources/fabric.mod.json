{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${mod_version}",
	"name": "${mod_name}",
	"description": "${mod_description}",
	"authors": ["pnku"],
	"contact": {
		"homepage": "https://www.pnku.de",
		"email": "contact@pnku.de",
		"sources": "https://github.com/pnk2u/${project_name}",
		"issues": "https://github.com/pnk2u/${project_name}/issues"
	},
	"license": "${mod_license}",
	"icon": "icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"${group_id}.${mod_id}.${archives_base_name}"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"accessWidener": "${mod_id}.classtweaker",
	"depends": {
		"fabricloader": ">=${minFabricLoaderVersion}",
		"minecraft": ">${minMinecraftVersionExcl} <${maxMinecraftVersionExcl}",
		"java": ">=${javaVersion}",
		"fabric-api": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.lieonlion.dev"
			}
		},
		"mc-publish": {
			"modrinth": "${modrinth_project_id}",
			"curseforge": "${curseforge_project_id}",
			"dependencies": [
				"fabric-api(required)#(ignore)"
			]
		}
	}
}